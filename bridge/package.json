{
  "name": "claude-chrome-android",
  "version": "1.6.0",
  "description": "Claude Code Browser Bridge for Android \u2014 connects Claude Code CLI to Chrome/Edge via WebSocket",
  "author": "willstone",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tribixbite/termux-tools"
  },
  "bin": {
    "claude-chrome-android": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "!dist/*.pem",
    "!dist/claude-code-bridge-v*.crx",
    "README.md"
  ],
  "scripts": {
    "build": "node build.cjs",
    "pub": "bash publish.sh",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "*",
    "@types/bun": "1.4.3",
    "@types/node": "26.6.5",
    "@types/ws": "8.18.2",
    "esbuild": "^0.24.0",
    "typescript": "^5.9.3",
    "ws": "^8.18.0"
  },
  "keywords": [
    "claude",
    "android",
    "termux",
    "browser-bridge",
    "chrome-extension",
    "mcp"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
