{
  "name": "termux-tools",
  "version": "1.0.0",
  "description": "Pinned stable/next channel managers for Claude Code (ccx), Codex (cdx) and Antigravity (agx) on Termux, plus the Termux tooling scripts from tribixbite/termux-tools",
  "license": "MIT",
  "author": "willstone",
  "homepage": "https://termux.party",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tribixbite/termux-tools.git",
    "directory": "claude-channel"
  },
  "bugs": "https://github.com/tribixbite/termux-tools/issues",
  "keywords": [
    "termux",
    "android",
    "claude-code",
    "codex",
    "antigravity",
    "channel-manager",
    "release-pinning"
  ],
  "bin": {
    "ccx": "dist/cli.js",
    "cdx": "dist/codex-cli.js",
    "agx": "dist/antigravity-cli.js",
    "pip-tool-install": "bin/pip-tool-install",
    "install-ghostty-termux": "bin/install-ghostty-termux",
    "install-antigravity-termux": "bin/install-antigravity-termux",
    "migrate-termux": "bin/migrate-termux",
    "threads-dl": "bin/threads-dl"
  },
  "files": [
    "dist/",
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "os": [
    "android",
    "linux"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bun run build.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
