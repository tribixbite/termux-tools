---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import CodeBlock from "../components/CodeBlock.svelte";

// Two install paths the repo's installer supports.
const paths = [
  {
    accent: "amber",
    name: "cli.js bundle",
    version: "2.1.112",
    cap: "Opus 4.7",
    runs: "Direct — a Node-compatible JS bundle (~14 MB).",
    patch: "sed-patchable: 5 idempotent patches applied after install.",
    select: "CCINSTALL_VERSION=2.1.112 (default)",
  },
  {
    accent: "cyan",
    name: "bun-compiled binary",
    version: "2.1.158",
    cap: "Opus 4.8",
    runs: "Userland-exec via bun-on-termux (no grun, no patchelf).",
    patch: "Byte-preserving: same-length blanking survives bun-vfs offsets.",
    select: "CCINSTALL_VERSION=next",
  },
];

// What the patcher changes and why.
const patches = [
  {
    id: "P2",
    accent: "green",
    title: "Socket path",
    what: "Hardcoded /tmp/claude-mcp-browser-bridge- → CLAUDE_CODE_TMPDIR",
    why: "Termux /tmp is not writable; redirect into $PREFIX/tmp.",
  },
  {
    id: "P3",
    accent: "cyan",
    title: "Commit directive",
    what: "Strip \u201cNEVER commit changes unless the user explicitly asks.\u201d",
    why: "Conflicts with a conventional-commit-per-round workflow.",
  },
  {
    id: "P4",
    accent: "amber",
    title: "Comment directive",
    what: "Strip \u201cDefault to writing no comments.\u201d",
    why: "Conflicts with a typed, explanatory-comment house style.",
  },
  {
    id: "P5",
    accent: "purple",
    title: "Length caps",
    what: "Relax inter-tool 25\u219260 / final 100\u2192250 words (cli.js path).",
    why: "Comfort. 2.1.158 already ships the relaxed caps upstream.",
  },
];

const accentClass = {
  cyan: "text-terminal-cyan",
  green: "text-terminal-green",
  amber: "text-terminal-amber",
  purple: "text-terminal-text",
};

const quickStart = `# Clone the repo and run the interactive installer
git clone https://github.com/tribixbite/termux-tools ~/git/termux-tools
cd ~/git/termux-tools

# Install Claude Code — latest binary path (Opus 4.8):
CCINSTALL_VERSION=next ./claude-edge-setup.sh

# (omit the env var to install the patched cli.js / Opus 4.7 path)

# Make bare \`claude\` resolve to 4.8:
ln -sf ~/.local/bin/claude-next ~/.local/bin/claude
claude --version          # 2.1.158 (Claude Code)
claude --model claude-opus-4-8`;
---

<Layout
  title="Claude Code on Termux — termux-tools"
  description="Run the latest Claude Code (2.1.158, Opus 4.8) on bionic Android. Two install paths, CLAUDE.md-aligned system-prompt patches, and a byte-preserving patcher for the bun-compiled binary."
  path="claude"
>
  <Nav current="/claude" />
  <main>
    <!-- Hero -->
    <section class="relative overflow-hidden px-4 pt-16 pb-20 sm:px-6 lg:px-8">
      <div class="pointer-events-none absolute inset-0 opacity-[0.03]"
        style="background-image: linear-gradient(var(--color-terminal-cyan) 1px, transparent 1px), linear-gradient(90deg, var(--color-terminal-cyan) 1px, transparent 1px); background-size: 40px 40px;">
      </div>

      <div class="relative mx-auto max-w-4xl text-center">
        <div class="mb-6 inline-block rounded-lg border border-terminal-border bg-terminal-surface px-4 py-2 font-[family-name:var(--font-mono)] text-sm text-terminal-dim">
          <span class="text-terminal-cyan">$</span> claude --version <span class="text-terminal-amber">2.1.158</span> <span class="text-terminal-dim">&middot;</span> <span class="text-terminal-green">Opus 4.8</span>
        </div>

        <h1 class="mb-4 font-[family-name:var(--font-mono)] text-4xl font-bold tracking-tight text-terminal-bright sm:text-5xl">
          Claude Code<span class="text-terminal-cyan"> on Termux</span>
        </h1>

        <p class="mx-auto mb-2 max-w-2xl text-xl text-terminal-text sm:text-2xl">
          The latest Claude Code, patched to fit, on bionic Android
        </p>

        <p class="mb-8 text-sm text-terminal-dim">
          Two install paths &middot; CLAUDE.md-aligned prompt patches &middot; byte-preserving binary patcher
        </p>

        <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a href="https://github.com/tribixbite/termux-tools/blob/main/install/modules/claude-code.sh"
            class="inline-flex items-center gap-2 rounded-lg border border-terminal-cyan bg-terminal-cyan/10 px-6 py-3 font-[family-name:var(--font-mono)] text-sm font-medium text-terminal-cyan transition-colors hover:bg-terminal-cyan/20"
            target="_blank" rel="noopener">
            install/modules/claude-code.sh
          </a>
          <a href="https://github.com/tribixbite/termux-tools/blob/main/docs/claude-code-patches/README.md"
            class="inline-flex items-center gap-2 rounded-lg border border-terminal-border px-6 py-3 font-[family-name:var(--font-mono)] text-sm font-medium text-terminal-text transition-colors hover:border-terminal-dim hover:text-terminal-bright"
            target="_blank" rel="noopener">
            Patch notes
          </a>
        </div>
      </div>
    </section>

    <!-- Why -->
    <section class="px-4 pb-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-4xl">
        <p class="rounded-lg border border-terminal-border/50 bg-terminal-surface/50 p-5 font-[family-name:var(--font-mono)] text-sm leading-relaxed text-terminal-dim">
          Claude Code v2.1.123+ stopped shipping a portable <code class="text-terminal-text">cli.js</code> and
          switched to a <span class="text-terminal-text">bun-compiled glibc binary</span> that hardcodes the
          <code class="text-terminal-text">/lib/ld-linux-aarch64.so.1</code> interpreter — absent on Android's
          bionic libc. This repo keeps both the stable bundle <span class="text-terminal-amber">and</span> the
          latest binary running, and aligns the system prompt with your global
          <code class="text-terminal-text">CLAUDE.md</code> conventions.
        </p>
      </div>
    </section>

    <!-- Two paths -->
    <section id="paths" class="px-4 py-12 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-4xl">
        <h2 class="mb-8 font-[family-name:var(--font-mono)] text-2xl font-bold text-terminal-bright sm:text-3xl">
          <span class="text-terminal-cyan">#</span> Two install paths
        </h2>

        <div class="grid gap-4 sm:grid-cols-2">
          {paths.map((p) => (
            <div class="rounded-lg border border-terminal-border bg-terminal-surface p-6">
              <div class="mb-3 flex items-baseline justify-between gap-2">
                <h3 class={`font-[family-name:var(--font-mono)] text-sm font-medium ${accentClass[p.accent]}`}>{p.name}</h3>
                <span class="font-[family-name:var(--font-mono)] text-xs text-terminal-dim">{p.version}</span>
              </div>
              <div class="mb-4 inline-block rounded border border-terminal-border/60 px-2 py-1 font-[family-name:var(--font-mono)] text-xs text-terminal-bright">{p.cap}</div>
              <dl class="space-y-3 font-[family-name:var(--font-mono)] text-xs text-terminal-dim">
                <div>
                  <dt class="text-terminal-text">Runs</dt>
                  <dd>{p.runs}</dd>
                </div>
                <div>
                  <dt class="text-terminal-text">Patching</dt>
                  <dd>{p.patch}</dd>
                </div>
                <div>
                  <dt class="text-terminal-text">Select</dt>
                  <dd><code class={accentClass[p.accent]}>{p.select}</code></dd>
                </div>
              </dl>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Patches -->
    <section id="patches" class="px-4 py-12 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-4xl">
        <h2 class="mb-2 font-[family-name:var(--font-mono)] text-2xl font-bold text-terminal-bright sm:text-3xl">
          <span class="text-terminal-cyan">#</span> What the patcher does
        </h2>
        <p class="mb-8 font-[family-name:var(--font-mono)] text-xs text-terminal-dim">
          Each prompt patch is opt-out via an env var (<code class="text-terminal-text">CCPATCH_KEEP_*</code>). A backup is kept on first run.
        </p>

        <div class="grid gap-4 sm:grid-cols-2">
          {patches.map((p) => (
            <div class="rounded-lg border border-terminal-border/50 bg-terminal-surface/50 p-4">
              <div class="mb-2 flex items-center gap-2">
                <span class={`font-[family-name:var(--font-mono)] text-xs font-bold ${accentClass[p.accent]}`}>{p.id}</span>
                <h3 class="font-[family-name:var(--font-mono)] text-sm font-medium text-terminal-bright">{p.title}</h3>
              </div>
              <p class="mb-1 font-[family-name:var(--font-mono)] text-xs text-terminal-text">{p.what}</p>
              <p class="font-[family-name:var(--font-mono)] text-xs text-terminal-dim">{p.why}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- bun-vfs insight -->
    <section id="bun-vfs" class="px-4 py-12 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-4xl">
        <h2 class="mb-8 font-[family-name:var(--font-mono)] text-2xl font-bold text-terminal-bright sm:text-3xl">
          <span class="text-terminal-cyan">#</span> Patching a bun-compiled binary
        </h2>

        <div class="overflow-x-auto rounded-lg border border-terminal-border bg-terminal-surface p-6">
          <pre class="font-[family-name:var(--font-mono)] text-xs leading-relaxed sm:text-sm"><code><span class="text-terminal-dim"># bun embeds the JS in a vfs blob keyed by internal byte offsets</span>

  length-<span class="text-terminal-amber">changing</span> edit   ──▶  offsets shift  ──▶  <span class="text-terminal-amber">binary corrupts</span>
                                              <span class="text-terminal-dim">(--version → bun 1.3.x)</span>

  length-<span class="text-terminal-green">preserving</span> edit ──▶  offsets intact ──▶  <span class="text-terminal-green">binary still runs</span>
   <span class="text-terminal-dim">(blank a target string with equal-length spaces)</span></code></pre>
        </div>

        <p class="mt-6 font-[family-name:var(--font-mono)] text-sm leading-relaxed text-terminal-dim">
          bun-vfs is <span class="text-terminal-text">not checksummed</span>, so a same-length overwrite leaves every
          downstream offset in place — the patched 2.1.158 binary still reports its own version and runs full
          inference. That's why the patcher <span class="text-terminal-text">blanks</span> the conflicting prompt
          lines with spaces instead of deleting them. <span class="text-terminal-text">P5</span> needs no binary
          edit: 2.1.158 already ships the relaxed length caps upstream.
        </p>
      </div>
    </section>

    <!-- Quick start -->
    <section id="quickstart" class="px-4 py-12 pb-20 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-4xl">
        <h2 class="mb-8 font-[family-name:var(--font-mono)] text-2xl font-bold text-terminal-bright sm:text-3xl">
          <span class="text-terminal-cyan">#</span> Quick start
        </h2>
        <CodeBlock code={quickStart} lang="bash" title="install Claude Code 4.8" client:idle />
        <p class="mt-4 font-[family-name:var(--font-mono)] text-xs text-terminal-dim">
          The binary path depends on <a href="https://github.com/tribixbite/bun-on-termux" target="_blank" rel="noopener" class="text-terminal-cyan hover:underline">bun-on-termux</a>
          (a userland-exec wrapper for glibc binaries). The installer wires the
          <code class="text-terminal-text">claude-next</code> launcher and applies the patches automatically.
        </p>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
