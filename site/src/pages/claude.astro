---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import CodeBlock from "../components/CodeBlock.svelte";

// The two channels ccx keeps for Claude Code.
const channels = [
  {
    accent: "cyan",
    name: "next",
    launcher: "~/.local/bin/claude-next",
    runs: "The newest release from Anthropic's native channel, fetched and patched by `ccx update`.",
    patch: "Byte-preserving: same-length edits survive bun-vfs offsets; a backup is kept.",
    select: "ccx update [--channel latest|stable] [--pin X.Y.Z]",
  },
  {
    accent: "amber",
    name: "stable",
    launcher: "~/.local/bin/claude",
    runs: "Whatever you last promoted. It never changes underneath you: the launcher sets DISABLE_AUTOUPDATER=1.",
    patch: "`ccx promote` snapshots next → stable and archives the outgoing binary for `ccx rollback`.",
    select: "ccx promote · ccx rollback [--to X.Y.Z]",
  },
];

// What the patcher changes and why.
const patches = [
  {
    id: "P1",
    accent: "green",
    title: "DNS resolver",
    what: "Rewrite the literal /etc/resolv.conf → /sdcard/dns.conf (same length).",
    why: "bun's bundled c-ares reads that absolute path with a raw syscall; Termux has no /etc/resolv.conf, so OAuth login and token refresh time out. Opt out: CCPATCH_KEEP_RESOLV=1.",
  },
  {
    id: "P2",
    accent: "cyan",
    title: "Socket path",
    what: "Launcher exports CLAUDE_CODE_TMPDIR=$PREFIX/tmp.",
    why: "Termux /tmp is not writable; Claude Code's own tmpdir helper honours the variable, so no binary edit is needed.",
  },
  {
    id: "P3",
    accent: "amber",
    title: "Commit directive",
    what: "Blank “NEVER commit changes unless the user explicitly asks.”",
    why: "Conflicts with a conventional-commit-per-round workflow. Opt out: CCPATCH_KEEP_NO_COMMIT=1.",
  },
  {
    id: "P4",
    accent: "purple",
    title: "Comment directive",
    what: "Blank “Default to writing no comments.”",
    why: "Conflicts with a typed, explanatory-comment house style. Opt out: CCPATCH_KEEP_NO_COMMENTS=1.",
  },
];

const accentClass = {
  cyan: "text-terminal-cyan",
  green: "text-terminal-green",
  amber: "text-terminal-amber",
  purple: "text-terminal-text",
};

const quickStart = `# Requirements: Termux + bun-on-termux (~/.bun/bin/bun-termux) + pkg install glibc-runner nodejs
npm i -g termux-tools          # ccx (Claude Code), cdx (Codex), agx (Antigravity)
export PATH="$HOME/.local/bin:$PATH"

ccx update                     # fetch + byte-patch the latest release into claude-next
claude-next --version          # try it
ccx promote                    # make it the stable \`claude\` (archives the previous one)
ccx status                     # channels, upstream versions, PATH check

# Something broke upstream? Go back in one command:
ccx rollback`;
---

<Layout
  title="Claude Code on Termux — termux-tools"
  description="Run current Claude Code on bionic Android with pinned stable/next channels. ccx fetches the native release, byte-patches the bun-compiled binary for Termux and promotes or rolls back atomically."
  path="claude"
>
  <Nav current="/claude" />
  <main>
    <!-- Hero -->
    <section class="relative overflow-hidden px-4 pt-16 pb-20 sm:px-6 lg:px-8">
      <div class="pointer-events-none absolute inset-0 opacity-[0.03]"
        style="background-image: linear-gradient(var(--color-terminal-cyan) 1px, transparent 1px), linear-gradient(90deg, var(--color-terminal-cyan) 1px, transparent 1px); background-size: 40px 40px;">
      </div>

      <div class="relative mx-auto max-w-4xl text-center">
        <div class="mb-6 inline-block rounded-lg border border-terminal-border bg-terminal-surface px-4 py-2 font-[family-name:var(--font-mono)] text-sm text-terminal-dim">
          <span class="text-terminal-cyan">$</span> ccx status <span class="text-terminal-dim">&middot;</span> <span class="text-terminal-amber">stable</span> pinned <span class="text-terminal-dim">&middot;</span> <span class="text-terminal-green">next</span> one command ahead
        </div>

        <h1 class="mb-4 font-[family-name:var(--font-mono)] text-4xl font-bold tracking-tight text-terminal-bright sm:text-5xl">
          Claude Code<span class="text-terminal-cyan"> on Termux</span>
        </h1>

        <p class="mx-auto mb-2 max-w-2xl text-xl text-terminal-text sm:text-2xl">
          Current Claude Code, patched to fit, pinned so it stays that way
        </p>

        <p class="mb-8 text-sm text-terminal-dim">
          stable / next channels &middot; CLAUDE.md-aligned prompt patches &middot; byte-preserving binary patcher
        </p>

        <div class="flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a href="https://www.npmjs.com/package/termux-tools"
            class="inline-flex items-center gap-2 rounded-lg border border-terminal-cyan bg-terminal-cyan/10 px-6 py-3 font-[family-name:var(--font-mono)] text-sm font-medium text-terminal-cyan transition-colors hover:bg-terminal-cyan/20"
            target="_blank" rel="noopener">
            npm i -g termux-tools
          </a>
          <a href="https://github.com/tribixbite/termux-tools/blob/main/claude-channel/README.md"
            class="inline-flex items-center gap-2 rounded-lg border border-terminal-border px-6 py-3 font-[family-name:var(--font-mono)] text-sm font-medium text-terminal-text transition-colors hover:border-terminal-dim hover:text-terminal-bright"
            target="_blank" rel="noopener">
            ccx · cdx · agx docs
          </a>
        </div>
      </div>
    </section>

    <!-- Why -->
    <section class="px-4 pb-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-4xl">
        <p class="rounded-lg border border-terminal-border/50 bg-terminal-surface/50 p-5 font-[family-name:var(--font-mono)] text-sm leading-relaxed text-terminal-dim">
          Claude Code ships as a <span class="text-terminal-text">bun-compiled glibc binary</span> that hardcodes the
          <code class="text-terminal-text">/lib/ld-linux-aarch64.so.1</code> interpreter — absent on Android's
          bionic libc — and reads <code class="text-terminal-text">/etc/resolv.conf</code> with a raw syscall that
          Termux cannot satisfy. <code class="text-terminal-text">ccx</code> fetches each release from Anthropic's
          native channel, runs it through <a href="https://github.com/tribixbite/bun-on-termux" target="_blank" rel="noopener" class="text-terminal-cyan hover:underline">bun-on-termux</a>'s
          userland exec, patches the binary without moving a byte, and keeps a
          <span class="text-terminal-amber">stable</span> launcher that only changes when you promote.
        </p>
      </div>
    </section>

    <!-- Channels -->
    <section id="channels" class="px-4 py-12 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-4xl">
        <h2 class="mb-8 font-[family-name:var(--font-mono)] text-2xl font-bold text-terminal-bright sm:text-3xl">
          <span class="text-terminal-cyan">#</span> Two channels
        </h2>

        <div class="grid gap-4 sm:grid-cols-2">
          {channels.map((c) => (
            <div class="rounded-lg border border-terminal-border bg-terminal-surface p-6">
              <div class="mb-3 flex items-baseline justify-between gap-2">
                <h3 class={`font-[family-name:var(--font-mono)] text-sm font-medium ${accentClass[c.accent]}`}>{c.name}</h3>
                <span class="font-[family-name:var(--font-mono)] text-xs text-terminal-dim">{c.launcher}</span>
              </div>
              <dl class="space-y-3 font-[family-name:var(--font-mono)] text-xs text-terminal-dim">
                <div>
                  <dt class="text-terminal-text">Runs</dt>
                  <dd>{c.runs}</dd>
                </div>
                <div>
                  <dt class="text-terminal-text">Patching</dt>
                  <dd>{c.patch}</dd>
                </div>
                <div>
                  <dt class="text-terminal-text">Commands</dt>
                  <dd><code class={accentClass[c.accent]}>{c.select}</code></dd>
                </div>
              </dl>
            </div>
          ))}
        </div>

        <p class="mt-6 font-[family-name:var(--font-mono)] text-xs text-terminal-dim">
          The same model runs Codex (<code class="text-terminal-text">cdx</code>: isolated Bun install, DNS and
          ripgrep fixes, no PRoot) and Google's Antigravity CLI (<code class="text-terminal-text">agx</code>:
          SHA-512 verified glibc binary launched through proot with its self-updater disabled). Every manager
          keeps immutable per-version releases, previews <code class="text-terminal-text">prune</code>, and
          only schedules <code class="text-terminal-text">next</code> updates when asked.
        </p>
      </div>
    </section>

    <!-- Patches -->
    <section id="patches" class="px-4 py-12 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-4xl">
        <h2 class="mb-2 font-[family-name:var(--font-mono)] text-2xl font-bold text-terminal-bright sm:text-3xl">
          <span class="text-terminal-cyan">#</span> What the patcher does
        </h2>
        <p class="mb-8 font-[family-name:var(--font-mono)] text-xs text-terminal-dim">
          Applied by <code class="text-terminal-text">ccx update</code> to every fetched binary. Each edit is opt-out via an env var (<code class="text-terminal-text">CCPATCH_KEEP_*</code>); a <code class="text-terminal-text">.bak-prepatch</code> copy is kept.
        </p>

        <div class="grid gap-4 sm:grid-cols-2">
          {patches.map((p) => (
            <div class="rounded-lg border border-terminal-border/50 bg-terminal-surface/50 p-4">
              <div class="mb-2 flex items-center gap-2">
                <span class={`font-[family-name:var(--font-mono)] text-xs font-bold ${accentClass[p.accent]}`}>{p.id}</span>
                <h3 class="font-[family-name:var(--font-mono)] text-sm font-medium text-terminal-bright">{p.title}</h3>
              </div>
              <p class="mb-1 font-[family-name:var(--font-mono)] text-xs text-terminal-text">{p.what}</p>
              <p class="font-[family-name:var(--font-mono)] text-xs text-terminal-dim">{p.why}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- bun-vfs insight -->
    <section id="bun-vfs" class="px-4 py-12 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-4xl">
        <h2 class="mb-8 font-[family-name:var(--font-mono)] text-2xl font-bold text-terminal-bright sm:text-3xl">
          <span class="text-terminal-cyan">#</span> Patching a bun-compiled binary
        </h2>

        <div class="overflow-x-auto rounded-lg border border-terminal-border bg-terminal-surface p-6">
          <pre class="font-[family-name:var(--font-mono)] text-xs leading-relaxed sm:text-sm"><code><span class="text-terminal-dim"># bun embeds the JS in a vfs blob keyed by internal byte offsets</span>

  length-<span class="text-terminal-amber">changing</span> edit   ──▶  offsets shift  ──▶  <span class="text-terminal-amber">binary corrupts</span>
                                              <span class="text-terminal-dim">(--version → bun 1.3.x)</span>

  length-<span class="text-terminal-green">preserving</span> edit ──▶  offsets intact ──▶  <span class="text-terminal-green">binary still runs</span>
   <span class="text-terminal-dim">(blank a string with equal-length spaces, or swap a path for one of the same length)</span></code></pre>
        </div>

        <p class="mt-6 font-[family-name:var(--font-mono)] text-sm leading-relaxed text-terminal-dim">
          bun-vfs is <span class="text-terminal-text">not checksummed</span>, so a same-length overwrite leaves every
          downstream offset in place: the patched binary still reports its own version and runs full inference.
          That's why <code class="text-terminal-text">ccx</code> <span class="text-terminal-text">blanks</span> the conflicting prompt
          lines with spaces instead of deleting them, and why the resolver redirect swaps
          <code class="text-terminal-text">/etc/resolv.conf</code> for the exactly-as-long <code class="text-terminal-text">/sdcard/dns.conf</code>.
        </p>
      </div>
    </section>

    <!-- Quick start -->
    <section id="quickstart" class="px-4 py-12 pb-20 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-4xl">
        <h2 class="mb-8 font-[family-name:var(--font-mono)] text-2xl font-bold text-terminal-bright sm:text-3xl">
          <span class="text-terminal-cyan">#</span> Quick start
        </h2>
        <CodeBlock code={quickStart} lang="bash" title="install Claude Code with ccx" client:idle />
        <p class="mt-4 font-[family-name:var(--font-mono)] text-xs text-terminal-dim">
          Updates come from <code class="text-terminal-text">downloads.claude.ai/claude-code-releases</code>, not npm.
          Each binary is ~250 MB; <code class="text-terminal-text">ccx prune</code> reclaims old ones (keeps 2 by default).
          <code class="text-terminal-text">ccx schedule --every 24</code> is opt-in and only refreshes <code class="text-terminal-text">next</code>.
        </p>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
