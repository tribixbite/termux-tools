---
// Static three-pillar feature cards — zero client JS

const features = [
  {
    icon: "🛡",
    title: "Custom Edge Canary Build",
    description: "A reproducible pipeline that strips 56+ tracking permissions, analytics SDKs (OneCollector, Adjust, Tencent Matrix, KOOM), Intune MDM and telemetry endpoints from Edge Canary, then re-signs the APK.",
    commands: [
      { cmd: "edge-fix/build.sh", desc: "unpack, patch, sign, zipalign" },
      { cmd: "patch-manifest.py", desc: "drop tracking permissions" },
      { cmd: "replace-urls.list", desc: "telemetry → 127.0.0.1" },
    ],
    color: "terminal-green",
    href: "/edge",
  },
  {
    icon: "📡",
    title: "CFC Browser Bridge",
    description: "A WebSocket bridge that wires the Edge extension to Claude Code's native Chrome host — exposing screenshots, navigation, form fill and JS-over-CDP as MCP tools inside any Claude session on Android.",
    commands: [
      { cmd: "claude-chrome-android", desc: "start the WS bridge" },
      { cmd: "--mcp", desc: "MCP relay per session" },
      { cmd: "--setup", desc: "register MCP + extension" },
    ],
    color: "terminal-amber",
    href: "/bridge",
  },
  {
    icon: "◆",
    title: "Claude Code on Termux",
    description: "Runs the latest Claude Code (2.1.158, Opus 4.8) on bionic Android. A byte-preserving patcher edits the bun-compiled binary's vfs in place, plus sed patches for the legacy cli.js path — aligned to your CLAUDE.md.",
    commands: [
      { cmd: "CCINSTALL_VERSION=next", desc: "install the 4.8 binary" },
      { cmd: "claude-code.sh", desc: "install + auto-patch" },
      { cmd: "byte-preserving", desc: "survives bun-vfs offsets" },
    ],
    color: "terminal-cyan",
    href: "/claude",
  },
  {
    icon: "⚙",
    title: "Termux Dev Tooling",
    description: "The glue that makes bionic Android a real dev box: a modular installer, x86_64 emulation via qemu, a Ghostty source build, pip-on-Termux fixes, ADB wireless automation and device-migration scripts.",
    commands: [
      { cmd: "x86-on-termux", desc: "run x86_64 binaries via qemu" },
      { cmd: "pip-tool-install", desc: "C-ext Python CLIs on Termux" },
      { cmd: "install-ghostty", desc: "GTK4 terminal, source build" },
    ],
    color: "terminal-text",
    href: "/docs",
  },
];
---

<section id="features" class="px-4 py-16 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-6xl">
    <h2 class="mb-12 text-center font-[family-name:var(--font-mono)] text-2xl font-bold text-terminal-bright sm:text-3xl">
      <span class="text-terminal-green">#</span> Core Features
    </h2>

    <div class="grid gap-6 sm:grid-cols-2">
      {features.map((f) => (
        <a href={f.href} class="group block rounded-lg border border-terminal-border bg-terminal-surface p-6 transition-colors hover:border-terminal-dim">
          <!-- Icon + Title -->
          <div class="mb-4 text-3xl">{f.icon}</div>
          <h3 class="mb-3 font-[family-name:var(--font-mono)] text-lg font-semibold text-terminal-bright group-hover:text-terminal-green">
            {f.title}
          </h3>
          <p class="mb-5 text-sm leading-relaxed text-terminal-dim">
            {f.description}
          </p>

          <!-- Key commands -->
          <div class="space-y-2">
            {f.commands.map((c) => (
              <div class="flex items-baseline gap-2 font-[family-name:var(--font-mono)] text-xs">
                <code class={`text-${f.color} shrink-0`}>{c.cmd}</code>
                <span class="text-terminal-dim">— {c.desc}</span>
              </div>
            ))}
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
